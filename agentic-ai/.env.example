# Module 5 — Environment Variables
# Copy this file to .env and fill in your values before running demos.
# Never commit .env to version control.

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# Optional: set AWS_PROFILE when you don't use the default AWS credential chain.
# AWS_PROFILE=<your-aws-profile>

# ── Module 8: Auth0 Live Identity ───────────────────────────────────────────
# Leave AGENT_MOCK_MODE unset or true for offline demos. Set false only after
# the Auth0 tenant, API, native app, and demo users are configured.
AGENT_MOCK_MODE=true
AUTH0_DOMAIN=<your-tenant>.us.auth0.com
AUTH0_AUDIENCE=https://api.devops-companion.internal
AUTH0_DEVICE_CLIENT_ID=<native-app-client-id>
AUTH0_REQUIRED_SCOPES=devops:analyze devops:iac devops:deploy:staging
AUTH0_DEMO_USER_EMAILS=<demo-user@example.com>

# Optional: used only by `python -m module8.live_check` for read-only inspection.
# Supply a short-lived token with read:clients, read:resource_servers, and read:users.
# AUTH0_MGMT_TOKEN=<short-lived-management-api-token>

# ── Module 8: CyberArk Agent Guard live MCP demo ─────────────────────────────
# Store a real demo secret in AWS Secrets Manager under this name using the
# configured AWS credential chain. The demo never prints the secret value.
MODULE8_AGC_SECRET_ID=devops-companion-github-token
MODULE8_AGC_SECRET_ENV=GITHUB_TOKEN
MODULE8_AGC_AUDIT_LOG=module8/generated/agent-guard-audit.log

# ── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to true to use mock tool data (no partner API keys needed).
# LLM calls via Bedrock are always live regardless of this setting.
AGENT_MOCK_DOMAIN=true

# ── Algolia (Customer Domain) ─────────────────────────────────────────────────
# Sign up free at algolia.com — use the Search API key (not Admin/Write)
ALGOLIA_APP_ID=<your-algolia-app-id>
ALGOLIA_API_KEY=<your-algolia-search-api-key>

# ── Deepgram (Voice Domain) ───────────────────────────────────────────────────
# Sign up free at console.deepgram.com — $200 free credit, no card required
DEEPGRAM_API_KEY=<your-deepgram-api-key>

# ── Mapbox (Geospatial Domain) ────────────────────────────────────────────────
# Sign up free at account.mapbox.com — default public token works for dev
MAPBOX_ACCESS_TOKEN=<your-mapbox-access-token>

# ── Amazon Location Service (Geospatial Domain) ───────────────────────────────
# Create these resources in your AWS account (us-east-1 recommended):
#   aws location create-place-index --index-name devops-place-index --data-source Esri --pricing-plan RequestBasedUsage --region us-east-1
#   aws location create-route-calculator --calculator-name devops-route-calculator --data-source Esri --pricing-plan RequestBasedUsage --region us-east-1
AGENT_LOCATION_INDEX_NAME=devops-place-index
AGENT_LOCATION_ROUTE_CALCULATOR=devops-route-calculator

# ── Amazon Lex V2 (Customer Domain — optional, mock handles it by default) ────
# AGENT_LEX_BOT_ID=<your-lex-bot-id>

# ── Amazon Personalize (Customer Domain — optional, mock handles it by default)
# AGENT_PERSONALIZE_CAMPAIGN_ARN=<your-campaign-arn>

# ── Amazon Connect (Customer Domain — optional, mock handles it by default) ───
# AGENT_CONNECT_INSTANCE_ID=<your-connect-instance-id>
# AGENT_CONNECT_CONTACT_FLOW_ID=<your-contact-flow-id>

# ── Module 7: Agent Memory Systems ───────────────────────────────────────────
# Set to true to use mock memory backends (no Redis/MongoDB/Neo4j credentials
# needed). LLM calls via Bedrock are always live regardless of this setting.
AGENT_MOCK_MEMORY=true

# TLS verification is secure by default and uses the bundled `certifi` CA bundle,
# so MongoDB Atlas / Neo4j Aura certificates validate out of the box — including
# on macOS Python builds with an empty system trust store. You normally never need
# the override below. Set it to true ONLY as a last-resort local-dev workaround to
# skip certificate verification. Never enable it in production.
# MODULE7_INSECURE_TLS=true

# ── Redis Cloud (Session Memory — LangGraph checkpointer) ────────────────────
# Sign up free at redis.io/cloud — free database, no credit card required.
REDIS_HOST=<your-redis-host>.db.redis.io
REDIS_PORT=<your-redis-port>
REDIS_USERNAME=default
REDIS_PASSWORD=<your-redis-password>
# REDIS_SESSION_TTL=86400

# ── MongoDB Atlas (Long-Term Semantic Memory — Vector Search) ────────────────
# Sign up free at mongodb.com/atlas — M0 free cluster. Create a Vector Search
# index named 'vector_index' (see module7/README.md for the definition).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DATABASE=agent_memory
MONGODB_COLLECTION=memories
MONGODB_VECTOR_INDEX=vector_index

# ── Neo4j Aura (Graph Relationship Memory) ───────────────────────────────────
# Sign up free at neo4j.com/cloud — AuraDB Free, no credit card required.
# AWS Marketplace: prodview-xd42uzj2v7dae
NEO4J_URI=<your-neo4j-aura-uri>
NEO4J_USERNAME=<your-neo4j-username>
NEO4J_PASSWORD=<your-neo4j-password>

# ── PII Guardrail (optional production layer) ────────────────────────────────
# Deterministic redaction of emails/phones/AWS keys is always on. Set a Bedrock
# Guardrail ID to add ML-based PII detection (e.g. names) on memory writes.
# MODULE7_BEDROCK_GUARDRAIL_ID=<your-bedrock-guardrail-id>
# MODULE7_BEDROCK_GUARDRAIL_VERSION=DRAFT

# ── Module 9: Data Pipelines and Lineage ─────────────────────────────────────
# Set to true to mock Confluent and Databricks in-process (no partner
# accounts needed). Layer with AGENT_MOCK_MEMORY=true for a fully offline
# run: AGENT_MOCK_PIPELINE=true AGENT_MOCK_MEMORY=true python demos/module9_demo.py
AGENT_MOCK_PIPELINE=true
# MODULE9_PORT=8089
# Narrow fallback: keep Delta Lake fully live but serve the Unity Catalog
# lineage record locally, for workspaces where system.access.table_lineage
# is not readable. Verify with: python -m module9.live_check
# DATABRICKS_MOCK_LINEAGE=true

# ── Knowledge sink: Amazon Bedrock Managed Knowledge Base (recommended) ──────
# Provisioned outside this repo; see module9/PARTNER_SETUP.md. Set both ids to
# use it. Unset them to fall back to the Module 7 memory path, or to the
# in-process mock under AGENT_MOCK_MEMORY. No vector store to provision.
# BEDROCK_KB_ID=
# BEDROCK_KB_DATA_SOURCE_ID=
# BEDROCK_KB_REGION=us-east-1

# ── Confluent Cloud (Act 1: real-time event streaming) ───────────────────────
# Sign up at confluent.cloud; prefer subscribing through AWS Marketplace for
# the larger credit allotment. Create a Basic cluster in the same region as
# Bedrock, create topic 'devops-events', then a cluster API key and secret.
CONFLUENT_BOOTSTRAP_SERVERS=<your-cluster>.confluent.cloud:9092
CONFLUENT_API_KEY=<your-cluster-api-key>
CONFLUENT_API_SECRET=<your-cluster-api-secret>
# CONFLUENT_TOPIC=devops-events
# CONFLUENT_GROUP_ID=module9-ingestion

# ── Databricks (Act 2: Delta Lake + Unity Catalog lineage) ───────────────────
# Free Edition (forever-free, serverless, Unity Catalog enabled) is the demo
# default. Create catalog 'devops' with schemas 'bronze' and 'silver', a
# serverless SQL warehouse, and a personal access token. Verify that
# system.access.table_lineage is readable in your edition during provisioning.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-personal-access-token>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<your-warehouse-id>
# DATABRICKS_CATALOG=devops
# DATABRICKS_BRONZE_SCHEMA=bronze
# DATABRICKS_SILVER_SCHEMA=silver
# DATABRICKS_BRONZE_TABLE=raw_events
# DATABRICKS_SILVER_TABLE=deployment_events
