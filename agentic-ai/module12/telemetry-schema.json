{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module 12 agent security telemetry",
  "type": "object",
  "required": [
    "workflow.id",
    "session.id",
    "agent.role",
    "content.exported"
  ],
  "properties": {
    "workflow.id": {"type": "string"},
    "workflow.scenario": {"type": "string"},
    "workflow.status": {"type": "string"},
    "session.id": {"type": "string"},
    "agent.role": {"type": "string"},
    "agent.model.id": {"type": "string"},
    "agent.stop_reason": {"type": "string"},
    "agent.input_tokens": {"type": "integer", "minimum": 0},
    "agent.output_tokens": {"type": "integer", "minimum": 0},
    "agent.total_tokens": {"type": "integer", "minimum": 0},
    "harness.digest": {"type": "string"},
    "tool.manifest.digest": {"type": "string"},
    "tool.name": {"type": "string"},
    "tool.sequence": {"type": "string"},
    "runtime.action": {"type": "string"},
    "runtime.request.type": {"type": "string"},
    "gateway.id": {"type": "string"},
    "gateway.target": {"type": "string"},
    "gateway.action": {"type": "string"},
    "gateway.status_code": {"type": "integer"},
    "gateway.request_id": {"type": "string"},
    "gateway.decision": {"enum": ["ALLOW", "DENY"]},
    "gateway.governance_source": {"type": "string"},
    "session.tainted": {"type": "boolean"},
    "taint.reason": {"type": "string"},
    "companion.posture": {"enum": ["healthy", "quarantine"]},
    "snyk.posture": {"enum": ["healthy", "quarantine"]},
    "policy.decision": {"enum": ["ALLOW", "DENY"]},
    "policy.rule": {"type": "string"},
    "approval.id": {"type": ["string", "null"]},
    "security.review.status": {"type": "string"},
    "financial.approval.status": {"type": "string"},
    "artifact.digest": {"type": "string"},
    "deployment.environment": {"type": "string"},
    "deployment.invocation_recorded": {"type": "boolean"},
    "smoke_test.status": {"type": "string"},
    "error.type": {"type": "string"},
    "content.exported": {"const": false}
  },
  "additionalProperties": true
}
